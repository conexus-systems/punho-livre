{
  "name": "mugen-arena",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "test": "jest",
    "test:tools": "node --test scripts/__tests__/*.test.mjs",
    "test:all": "jest && node --test scripts/__tests__/*.test.mjs && npx tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "roster": "node scripts/roster/generate.mjs && node scripts/build-character-index.mjs",
    "characters": "node scripts/build-character-index.mjs",
    "pack": "node scripts/mugen-pack.mjs",
    "preview": "jest -c scripts/preview/jest.config.js"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@shopify/react-native-skia": "2.14.0",
    "expo": "~58.0.14",
    "expo-auth-session": "~58.0.13",
    "expo-build-properties": "~58.0.11",
    "expo-constants": "~58.0.12",
    "expo-crypto": "~58.0.7",
    "expo-file-system": "~58.0.9",
    "expo-haptics": "~58.0.7",
    "expo-linking": "~58.0.13",
    "expo-router": "~58.0.23",
    "expo-screen-orientation": "~58.0.3",
    "expo-secure-store": "~58.0.2",
    "expo-status-bar": "~58.0.3",
    "expo-tracking-transparency": "~58.0.2",
    "expo-web-browser": "~58.0.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-google-mobile-ads": "^17.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/react": "~19.3.0",
    "jest": "^30.5.2",
    "jest-expo": "^58.0.11",
    "typescript": "~7.0.2"
  },
  "overrides": {
    "uuid": "^11.1.1"
  },
  "jest": {
    "preset": "jest-expo",
    "testMatch": [
      "**/__tests__/**/*.test.ts?(x)"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/"
    ]
  },
  "engines": {
    "node": ">=20"
  }
}
