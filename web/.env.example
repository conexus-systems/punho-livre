# --- CONEXUS (flags do template conexus-bff-stack) ---
AUTH_PROVIDER=conexus
BILLING_PROVIDER=conexus
MESSAGING_PROVIDER=conexus
CONEXUS_AUTH_URL=https://auth.conexus-systems.com.br
CONEXUS_PAYMENTS_URL=https://payments.conexus-systems.com.br
CONEXUS_API_URL=https://api.conexus-systems.com.br
CONEXUS_AUTH_CLIENT_ID=
CONEXUS_AUTH_CLIENT_SECRET=
CONEXUS_WEBHOOK_SECRET=
CONEXUS_API_WEBHOOK_SECRET=
CONEXUS_PRODUCT_SLUG=mugen-arena

# --- Verificação do JWT do bff-auth ---
# iss esperado (padrão: CONEXUS_AUTH_URL)
CONEXUS_AUTH_ISSUER=
# client_id(s) do app mobile aceitos no `aud`, separados por vírgula
CONEXUS_AUTH_ALLOWED_AUDIENCES=
# CONEXUS_AUTH_LEEWAY_SECONDS=30

# --- MUGEN Arena ---
# valores do claim `groups` que dão acesso a /api/v1/admin
ADMIN_GROUPS=mugen-arena-admin,admin
# quem recebe "personagem submetido" (separados por vírgula)
ADMIN_NOTIFY_EMAILS=
# partidas de sala privada contam para o rating?
RATED_ROOM_MATCHES=false
# CORS_ORIGINS=*

# --- Jogo pago: licença da Google Play para o online (docs/PROTOCOL.md → Licença) ---
# 1 = fila e salas exigem cópia comprada (produção); vazio/0 = todos liberados (dev, testes)
PLAY_INTEGRITY_REQUIRED=
PLAY_INTEGRITY_PACKAGE=br.com.conexus.bamba
# JSON da conta de serviço do Google Cloud com acesso à Play Integrity API (nunca no Git)
PLAY_INTEGRITY_SERVICE_ACCOUNT=

# --- Banco (padrão frota: variáveis discretas, nunca DATABASE_URL) ---
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=mugen_arena_development
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=
# PGSSLMODE=require

# --- Runtime ---
RAILS_MAX_THREADS=3
# Produção (secret do módulo rails-lke): Solid Queue no Puma, async.
# SOLID_QUEUE_IN_PUMA=true
# JOB_THREADS=2
# JOB_POLLING_INTERVAL=1
# DATABASE_IDLE_TIMEOUT=60
# DATABASE_REAPING_FREQUENCY=30
# SOLID_CABLE_POLLING_INTERVAL=0.05
# SECRET_KEY_BASE=
PACK_MAX_BYTES=5242880
