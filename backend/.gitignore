# See https://help.github.com/articles/ignoring-files for more about ignoring files.
/.bundle
/vendor/bundle

# Variáveis de ambiente locais (só o exemplo é versionado)
/.env*
!/.env.example

/log/*
/tmp/*
!/log/.keep
!/tmp/.keep
/tmp/pids/*
!/tmp/pids/.keep

/config/master.key
/config/credentials/*.key

/coverage
/spec/examples.txt
